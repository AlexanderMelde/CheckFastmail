{
  "name": "checkfastmail",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:site": "vite -c vite.config.site.ts",
    "build:site": "vite build -c vite.config.site.ts",
    "preview:site": "vite preview -c vite.config.site.ts",
    "build:all": "npm run build && npm run build:site",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
