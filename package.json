{
  "name": "checkfastmail",
  "private": true,
  "version": "1.2.0",
  "description": "Lightweight, privacy-first Fastmail unread email checker Chrome extension.",
  "license": "Apache-2.0",
  "author": "Alexander Melde <check-fastmail@melde.net> (https://melde.net/)",
  "homepage": "https://check-fastmail.melde.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderMelde/CheckFastmail.git"
  },
  "bugs": {
    "url": "https://github.com/AlexanderMelde/CheckFastmail/issues"
  },
  "keywords": [
    "fastmail",
    "chrome-extension",
    "jmap",
    "svelte5",
    "typescript",
    "privacy"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:site": "vite -c vite.config.site.ts",
    "build:site": "vite build -c vite.config.site.ts",
    "preview:site": "vite preview -c vite.config.site.ts",
    "build:all": "npm run build && npm run build:site",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/** --coverage.exclude=src/**/*.test.ts --coverage.exclude=src/vite-env.d.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}
